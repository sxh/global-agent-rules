{
  "$schema": "https://opencode.ai/config.json",
  "model": "my-deepseek/deepseek-v4-flash",
  "default_agent": "stepwise",
  "provider": {
    "my-deepseek": {
      "name": "My DeepSeek",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.deepseek.com/v1",
        "apiKey": "{env:OPENCODE_DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash": { "id": "deepseek-v4-flash" }
      }
    },
    "mimo": {
      "name": "Xiaomi MiMo",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://token-plan-ams.xiaomimimo.com/v1",
        "apiKey": "{env:OPENCODE_MIMO_API_KEY}"
      },
      "models": {
        "mimo-v2.5": { "id": "mimo-v2.5" }
      }
    },
    "local-model": {
          "npm": "@ai-sdk/openai-compatible",
          "name": "Local Qwen 3.5",
          "options": {
            "baseURL": "http://localhost:1234/v1"
          },
          "models": {
            "local-model": {
              "name": "qwen3.5-9b"
            }
          }
        }
  },
  "disabled_providers": ["deepseek"],
  "plugin": ["~/.config/opencode/plugins/pcp.ts"],
  "lsp": {
    "jdtls": {
      "disabled": true
    }
  }
}

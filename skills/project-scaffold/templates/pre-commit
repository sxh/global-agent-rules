# FFI_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(gleam|mjs)$' \
#   | xargs grep -l '@external' 2>/dev/null || true)
# if [ -n "$FFI_FILES" ]; then
#   echo "ERROR: FFI (@external) detected — requires explicit user authorisation"
#   echo "$FFI_FILES"
#   exit 1
# fi

# --- 8. Smoke test: the app builds, launches and renders (apps with a build pipeline/shell) ---
# Unit tests verify logic; a smoke test verifies integration. Poll for readiness, don't sleep.
# npm run smoke

echo "pre-commit gate passed"
